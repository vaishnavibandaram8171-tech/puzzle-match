// Check for horizontal and vertical matches in a grid
function findMatches(grid, rows, cols) {
    let matches = [];

    // Check horizontal matches
    for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols - 2; c++) {
            let val = grid[r][c];
            if (val !== null && val === grid[r][c + 1] && val === grid[r][c + 2]) {
                matches.push({r, c}, {r, c: c + 1}, {r, c: c + 2});
            }
        }
    }

    // Check vertical matches
    for (let c = 0; c < cols; c++) {
        for (let r = 0; r < rows - 2; r++) {
            let val = grid[r][c];
            if (val !== null && val === grid[r + 1][c] && val === grid[r + 2][c]) {
                matches.push({r, c}, {r: r + 1, c}, {r: r + 2, c});
            }
        }
    }

    return matches; // Returns array of matched tile coordinates
}
